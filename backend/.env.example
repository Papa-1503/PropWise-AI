MONGO_URL=mongodb://localhost:27017
DB_NAME=rentflow
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
UPLOAD_DIR=./uploads/inspection_photos

# Mailgun — required for every outbound email this app sends (welcome
# emails, password reset, renewal campaigns, collections reminders,
# etc.) - see email_service.py's own docstring for why this app uses
# Mailgun's HTTP API rather than SMTP (Render's free tier blocks
# outbound SMTP ports entirely). MAILGUN_API_KEY must be a real
# "Mailgun API key" created under Sending -> API keys in the Mailgun
# dashboard - NOT the "HTTP webhook signing key" shown on that same
# page (a different credential, for a different purpose - using it
# here fails with a real, confirmed "Mailgun returned 401: Forbidden"
# and silently blocks every email this app tries to send, with no
# visible error to any user, until it's diagnosed from the server
# logs). MAILGUN_DOMAIN can be Mailgun's own sandbox domain (works
# immediately, but can only send to recipient addresses you've
# manually authorized under that domain's own settings) or a real
# verified custom domain, which can send to anyone.
MAILGUN_API_KEY=your-real-mailgun-api-key
MAILGUN_DOMAIN=your-domain.mailgun.org
FROM_EMAIL=you@example.com

# Stripe Billing — required for the SaaS subscription/trial-enforcement
# system (routers/billing.py, billing_service.py) to work. Distinct from
# whatever Stripe keys power resident rent-payment ACH (stripe_service.py) -
# same real Stripe account can supply both, but this needs its own real
# Price object and its own real webhook endpoint/secret (see
# billing_service.py's own docstring for why the two webhook streams are
# kept independent).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Twilio SMS/Voice — TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and
# TWILIO_FROM_NUMBER (a real Twilio number in E.164 format) are required
# for SMS/voice features (routers/telephony.py, routers/sms_inbound.py,
# sms_service.py). TWILIO_FROM_NUMBER is the SHARED default number used
# by any organization that hasn't configured its own dedicated number -
# an organization can set its own via PATCH /api/organizations/me
# (organizations_col.smsNumber), which real, meaningfully improves
# cross-org isolation for inbound texts. See sms_service.py's own
# docstring for the full reasoning.

# Sentry — optional, real error monitoring (main.py). Genuinely
# missing before this. Runs as a real, safe no-op with no behavior
# change at all if SENTRY_DSN isn't set - only configure it once you
# have a real Sentry project (free tier is enough to start).
SENTRY_DSN=https://your-real-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX
SENTRY_ENVIRONMENT=production

# NOTE: this file is not a complete list of every environment variable
# this app actually reads - STRIPE_WEBHOOK_SECRET (rent ACH), SEED_SECRET,
# TWILIO_*, CLOUDINARY_*, and others are also required for their
# respective features but aren't documented here yet - a real, separate
# gap in this file, not something this change attempts to fully close.
