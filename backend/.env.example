MONGO_URL=mongodb://localhost:27017
DB_NAME=rentflow
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
UPLOAD_DIR=./uploads/inspection_photos

# SMTP — required for renewal-campaign and collections-reminder emails to
# actually send. Works with any SMTP provider, including a Gmail account
# for local testing (use an App Password, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=you@example.com

# Stripe Billing — required for the SaaS subscription/trial-enforcement
# system (routers/billing.py, billing_service.py) to work. Distinct from
# whatever Stripe keys power resident rent-payment ACH (stripe_service.py) -
# same real Stripe account can supply both, but this needs its own real
# Price object and its own real webhook endpoint/secret (see
# billing_service.py's own docstring for why the two webhook streams are
# kept independent).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Twilio SMS/Voice — TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and
# TWILIO_FROM_NUMBER (a real Twilio number in E.164 format) are required
# for SMS/voice features (routers/telephony.py, routers/sms_inbound.py,
# sms_service.py). TWILIO_FROM_NUMBER is the SHARED default number used
# by any organization that hasn't configured its own dedicated number -
# an organization can set its own via PATCH /api/organizations/me
# (organizations_col.smsNumber), which real, meaningfully improves
# cross-org isolation for inbound texts. See sms_service.py's own
# docstring for the full reasoning.

# NOTE: this file is not a complete list of every environment variable
# this app actually reads - STRIPE_WEBHOOK_SECRET (rent ACH), SEED_SECRET,
# TWILIO_*, CLOUDINARY_*, and others are also required for their
# respective features but aren't documented here yet - a real, separate
# gap in this file, not something this change attempts to fully close.
